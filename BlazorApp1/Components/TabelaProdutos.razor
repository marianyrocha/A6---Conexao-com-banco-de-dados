@using BlazorApp1.Components.Models

<div class="col-md-8">
    <table class="table">
        <thead>
        <tr>
            <th>Nome</th>
            <th>Quantidade</th>
            <th>Preço</th>
        </tr>
        </thead>
        <tbody>

  

        @foreach (var p in produtos)
        {
            <tr>
                <td>@p.Nome</td>
                <td>@p.Quantidade</td>
                <td>@p.Preco</td>
                <td><button class="btn btn-danger btn-sm"
                            @onclick="() => excluir.InvokeAsync(p)"
                            >Excluir</button></td>
                
            </tr>
        }

        </tbody>

    </table>

</div>


@code{

    [Parameter] 
    public List<Produto> produtos { get; set; } = new();
    [Parameter] 
    public EventCallback<Produto> excluir { get; set; } = new();

}



