        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="Components\Pages\Produtos\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Components\Pages\Produtos\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="Components\Pages\Produtos\**" />
      <Content Remove="Components\NomeInput.razor" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Components\Pages\Produtos\**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Components\prints\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
